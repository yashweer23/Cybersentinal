# Run scripts/Initialize-Environment.ps1 to create .env with random local secrets.
# These ports belong to your Windows host. Internal ports: frontend 8080, backend 8000, db 5432.
# POSTGRES_PORT is published only with compose.dev.yml; keep your existing working value.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=15432
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_LOCALLY
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Generate locally with Initialize-Environment.ps1. Never use the placeholder as a key.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_LOCALLY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Additional exact browser origins for auth cookies, e.g. your deployed Swagger origin.
# Local frontend origins come from CORS_ORIGINS; local API origins use BACKEND_PORT.
AUTH_TRUSTED_ORIGINS=[]
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_REFRESH_LIMIT=30

# Optional ingestion limits; existing .env files work with these defaults.
INGESTION_MAX_BATCH_SIZE=1000
INGESTION_MAX_ERRORS=20
INGESTION_MAX_EVENT_BYTES=262144
INGESTION_MAX_REQUEST_BYTES=8388608
INGESTION_MAX_JSON_FILE_BYTES=16777216

# Phase 6: bounded detection runs and evidence (optional).
DETECTION_BATCH_SIZE=500
DETECTION_MAX_BATCHES=100
DETECTION_MAX_CONTEXT_EVENTS=50000
DETECTION_EVIDENCE_LIMIT=100

# Phase 7: bounded risk-scoring runs. RISK_SCORING accepts optional JSON policy overrides.
RISK_BATCH_SIZE=250
RISK_MAX_BATCHES=100
RISK_MAX_CONTEXT_EVENTS=10000

# Phase 8: incident promotion and bounded correlation
INCIDENT_MIN_RISK_SCORE=50
INCIDENT_CORRELATION_WINDOW_MINUTES=60
INCIDENT_CORRELATION_MIN_SCORE=8
# 0 disables automatic reopening. FALSE_POSITIVE cases never auto-reopen.
INCIDENT_REOPEN_WINDOW_MINUTES=0
INCIDENT_BATCH_SIZE=100
INCIDENT_MAX_BATCHES=100
INCIDENT_MAX_CANDIDATES=1000

# Phase 9: mock mode is offline. Set THREAT_INTELLIGENCE_MOCK_MODE=false explicitly for live provider lookups.
THREAT_INTELLIGENCE_ENABLED=true
THREAT_INTELLIGENCE_MOCK_MODE=true
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_ENABLED=true
VIRUSTOTAL_ENABLED=true
OTX_ENABLED=true
THREAT_INTELLIGENCE_CACHE_TTL_HOURS=24
THREAT_INTELLIGENCE_ERROR_TTL_SECONDS=300
THREAT_INTELLIGENCE_TIMEOUT_SECONDS=10
THREAT_INTELLIGENCE_MAX_RESPONSE_BYTES=524288
THREAT_INTELLIGENCE_MAX_INCIDENTS=50
THREAT_INTELLIGENCE_MAX_INDICATORS=100
THREAT_INTELLIGENCE_ABUSEIPDB_INTERVAL_SECONDS=1
THREAT_INTELLIGENCE_VIRUSTOTAL_INTERVAL_SECONDS=15
THREAT_INTELLIGENCE_OTX_INTERVAL_SECONDS=1
THREAT_INTELLIGENCE_MAX_RETRIES=1
THREAT_INTELLIGENCE_MAX_RETRY_DELAY_SECONDS=2
THREAT_INTELLIGENCE_RUN_TIMEOUT_SECONDS=60

# Phase 10: read-only analytics limits; existing environment files remain valid.
DASHBOARD_MAX_RANGE_DAYS=90
DASHBOARD_SLOW_QUERY_MS=250

# Phase 13 — optional AI assistance. Blank provider/key/model uses deterministic fallback.
# Only openai (Responses API with structured outputs) and fallback are supported.
# Legacy LLM_API_KEY is unused; AI_API_KEY is the optional server-only credential.
AI_ANALYST_ENABLED=true
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_CONTEXT_EVENTS=50
AI_MAX_CONTEXT_FINDINGS=20
AI_MAX_RESPONSE_TOKENS=1500
AI_ANALYSIS_CACHE_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
AI_FALLBACK_CACHE_SECONDS=60

# Phase 15 operational settings. Existing .env files use these defaults automatically.
# APP_ENV=development supports local HTTP; production requires HTTPS for secure auth cookies.
# Keep actual secrets server-side. Never prefix any secret with VITE_.
API_DOCS_ENABLED=true
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
# Proxy forwarding is OFF by default. Enable only with a verified, restricted proxy IP/CIDR.
PROXY_HEADERS_ENABLED=false
FORWARDED_ALLOW_IPS=["127.0.0.1","::1"]
# Internal server defaults; Compose fixes host/port at 0.0.0.0:8000.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Only one worker is supported while authentication rate limits are process-local.
SERVER_WORKERS=1
SERVER_GRACEFUL_TIMEOUT_SECONDS=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=3000
# Frontend uses same-origin /api. No VITE_API_BASE_URL or browser-side secrets are required.

# Phase 18 cloud-only options. Keep these commented for local Compose.
# Render supplies DATABASE_URL from the managed database; never paste it into Git.
# DATABASE_URL=<provider-managed secret>
# DATABASE_SSLMODE=require
# EXPECTED_DATABASE_NAME=cybersentinel
# PUBLIC_ORIGIN=https://<actual-public-host-without-trailing-slash>
# PUBLIC_ORIGIN sets exact CORS/auth origin, allowed Host and canonical HTTPS.
# It requires a private backend behind an HTTPS gateway and PROXY_HEADERS_ENABLED=false.
# See docs/DEPLOYMENT.md for provider TLS and trusted-proxy limitations.
